{{ p.name | upper }} = Projection(
    name="{{ p.name }}",
    read_model="{{ p.read_model }}",
    owner_service="{{ p.owner_service }}",
    source_tables={{ p.source_tables }},
    source_services={{ p.source_services }},
)
{% endfor %}

PROJECTIONS: dict[str, Projection] = {
{% for p in projections %}
    "{{ p.name }}": {{ p.name | upper }},
{% endfor %}
}


class Projector:
    """Routes outbox events to projection handlers: event 'orders.order_created' -> on_orders_order_created."""

    def apply(self, event_type: str, payload: dict[str, Any]) -> None:
        handler = getattr(self, "on_" + event_type.replace(".", "_"), None)
        if handler is not None:
            handler(payload)
        else:
            log.debug("no handler for event %s", event_type)

{% for p in projections %}
{% for table in p.source_tables %}
    def on_{{ table }}_changed(self, payload: dict[str, Any]) -> None:
        """Refresh {{ p.name }} when a row in `{{ table }}` changes."""
        entity_id = payload.get("id")
        if entity_id is not None:
            {{ p.name | upper }}.upsert(entity_id, {"{{ table }}": payload})

{% endfor %}
{% endfor %}


async def run_projector(projector: Projector, redis_client: Any, stream: str = "reposplit:events", poll_ms: int = 1000) -> None:
    """Subscribe to a Redis Stream and feed events into the projector.

    Runs until cancelled. Start with asyncio.create_task(run_projector(...)).

    Args:
        projector: Projector instance with on_<event> handlers.
        redis_client: An async redis.asyncio client (from_url(REDIS_URL)).
        stream: Redis Stream key to consume from.
        poll_ms: Blocking read timeout in milliseconds (controls shutdown latency).
    """
    last_id = "0"  # Start from the beginning; use "$" to only get new events
    log.info("CQRS projector starting on stream %s", stream)
    while True:
        try:
            messages = await redis_client.xread({stream: last_id}, block=poll_ms, count=100)
            for _stream_name, entries in (messages or []):
                for msg_id, data in entries:
                    event_type = data.get(b"event_type", b"").decode() if isinstance(data.get(b"event_type"), bytes) else data.get("event_type", "")
                    raw_payload = data.get(b"payload", b"{}") if isinstance(data.get(b"payload"), bytes) else data.get("payload", "{}")
                    try:
                        payload = json.loads(raw_payload)
                    except (ValueError, TypeError):
                        payload = {}
                    projector.apply(event_type, payload)
                    last_id = msg_id
                    log.debug("applied event %s id=%s", event_type, msg_id)
        except asyncio.CancelledError:
            log.info("CQRS projector cancelled, shutting down")
            return
        except Exception as exc:  # noqa: BLE001
            log.warning("projector error (will retry): %s", exc)
            await asyncio.sleep(1)


