"""CQRS read projections generated by RepoSplit 2.0 (DataSplit Engine).

Cross-database SQL JOINs are impossible once each service owns its schema. Every projection below
replaces one such JOIN with a denormalised read model that is rebuilt from domain events published
through the Outbox (see outbox.py). Reads become a single key lookup.

Default store is an in-memory dict so the scaffold runs anywhere; `RedisStore` is a drop-in.

TODO(team): subscribe `Projector.apply` to the event bus (NATS/Kafka/Redis Streams) and implement
each `on_<event>` handler with the fields the frontend actually needs.
"""

from __future__ import annotations

import json
from dataclasses import dataclass, field
from typing import Any, Protocol


class ReadStore(Protocol):
    def get(self, key: str) -> dict[str, Any] | None: ...
    def put(self, key: str, value: dict[str, Any]) -> None: ...


class MemoryStore:
    def __init__(self) -> None:
        self._data: dict[str, dict[str, Any]] = {}

    def get(self, key: str) -> dict[str, Any] | None:
        return self._data.get(key)

    def put(self, key: str, value: dict[str, Any]) -> None:
        self._data[key] = value


class RedisStore:
    """pip install redis; RedisStore(redis.Redis.from_url(REDIS_URL))."""

    def __init__(self, client: Any, prefix: str = "reposplit:view:") -> None:
        self._r = client
        self._prefix = prefix

    def get(self, key: str) -> dict[str, Any] | None:
        raw = self._r.get(self._prefix + key)
        return json.loads(raw) if raw else None

    def put(self, key: str, value: dict[str, Any]) -> None:
        self._r.set(self._prefix + key, json.dumps(value))


@dataclass
class Projection:
    name: str
    read_model: str
    owner_service: str
    source_tables: list[str]
    source_services: list[str]
    store: ReadStore = field(default_factory=MemoryStore)

    def key(self, entity_id: Any) -> str:
        return f"{self.read_model}:{entity_id}"

    def read(self, entity_id: Any) -> dict[str, Any] | None:
        return self.store.get(self.key(entity_id))

    def upsert(self, entity_id: Any, patch: dict[str, Any]) -> dict[str, Any]:
        current = self.read(entity_id) or {}
        current.update(patch)
        self.store.put(self.key(entity_id), current)
        return current


{% for p in projections %}
{{ p.name | upper }} = Projection(
    name="{{ p.name }}",
    read_model="{{ p.read_model }}",
    owner_service="{{ p.owner_service }}",
    source_tables={{ p.source_tables }},
    source_services={{ p.source_services }},
)
{% endfor %}

PROJECTIONS: dict[str, Projection] = {
{% for p in projections %}
    "{{ p.name }}": {{ p.name | upper }},
{% endfor %}
}


class Projector:
    """Routes outbox events to projection handlers: event 'orders.order_created' -> on_orders_order_created."""

    def apply(self, event_type: str, payload: dict[str, Any]) -> None:
        handler = getattr(self, "on_" + event_type.replace(".", "_"), None)
        if handler is not None:
            handler(payload)

{% for p in projections %}
{% for table in p.source_tables %}
    def on_{{ table }}_changed(self, payload: dict[str, Any]) -> None:
        """Refresh {{ p.name }} when a row in `{{ table }}` changes."""
        # TODO(team): map payload fields into the {{ p.read_model }} document.
        {{ p.name | upper }}.upsert(payload.get("id"), {"{{ table }}": payload})

{% endfor %}
{% endfor %}
