# Generated by RepoSplit 2.0 - Strangler Fig topology.
# Clients talk to the gateway (:{{ gateway_port }}); the monolith stays the default upstream while each
# extracted service receives its canary share of traffic.
services:
  monolith:
    build:
      context: {{ monolith_context }}
    environment:
      PORT: "5000"
      DATABASE_URL: sqlite:////data/shop.sqlite
    volumes:
      - monolith-data:/data
    ports:
      - "5000:5000"

  gateway:
    image: envoyproxy/envoy:v1.31-latest
    command: ["envoy", "-c", "/etc/envoy/envoy.yaml", "--log-level", "info"]
    volumes:
      - ./gateway/envoy.yaml:/etc/envoy/envoy.yaml:ro
    ports:
      - "{{ gateway_port }}:{{ gateway_port }}"
      - "9901:9901"
    depends_on:
      - monolith
{% for svc in services %}
      - {{ svc.service }}
{% endfor %}

{% for svc in services %}
  {{ svc.service }}:
    build:
      context: ./services/{{ svc.service }}
    environment:
      PORT: "{{ svc.port }}"
      DATABASE_URL: sqlite:////data/{{ svc.service }}.sqlite
{% for dep in svc.downstream %}
      {{ dep | upper }}_URL: http://{{ dep }}:{{ ports[dep] }}
{% endfor %}
      OTEL_SERVICE_NAME: {{ svc.service }}
    volumes:
      - {{ svc.service }}-data:/data
    ports:
      - "{{ svc.port }}:{{ svc.port }}"

{% endfor %}
volumes:
  monolith-data:
{% for svc in services %}
  {{ svc.service }}-data:
{% endfor %}
