# Generated by RepoSplit 2.0. Override image.registry for your OpenShift internal registry.
image:
  registry: image-registry.openshift-image-registry.svc:5000/{{ release }}
  tag: latest
gateway:
  enabled: true
  port: {{ gateway_port }}
monolith:
  enabled: true
  port: 5000
otel:
  # IBM Instana / OpenTelemetry collector endpoint
  endpoint: http://instana-agent.instana-agent.svc:4317
services:
{% for svc in services %}
  - name: {{ svc.service }}
    port: {{ svc.port }}
    replicas: 2
    env:
{% for dep in svc.downstream %}
      {{ dep | upper }}_URL: http://{{ dep }}:{{ ports[dep] }}
{% endfor %}
{% endfor %}
