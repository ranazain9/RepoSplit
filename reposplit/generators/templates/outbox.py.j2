"""Transactional Outbox generated by RepoSplit 2.0.

Domain events are written to the `outbox` table in the same transaction as the business change,
then relayed to the message bus by a separate publisher. This guarantees at-least-once delivery
without distributed transactions (the pattern Sagas and CQRS projections rely on).
"""

from __future__ import annotations

import json
import uuid
from datetime import UTC, datetime
from typing import Any

from sqlalchemy import Column, DateTime, String, Text
from sqlalchemy.orm import Session, declarative_base

OutboxBase = declarative_base()


class OutboxEvent(OutboxBase):
    __tablename__ = "outbox"

    id = Column(String(32), primary_key=True, default=lambda: uuid.uuid4().hex)
    aggregate = Column(String(64), nullable=False)
    event_type = Column(String(128), nullable=False, index=True)
    payload = Column(Text, nullable=False)
    created_at = Column(DateTime, nullable=False, default=lambda: datetime.now(UTC))
    published_at = Column(DateTime, nullable=True, index=True)


class Outbox:
    def __init__(self, session: Session) -> None:
        self._session = session

    def publish(self, event_type: str, payload: dict[str, Any], aggregate: str = "{{ service }}") -> OutboxEvent:
        event = OutboxEvent(aggregate=aggregate, event_type=event_type, payload=json.dumps(payload, default=str))
        self._session.add(event)
        return event


def relay_pending(session: Session, sink) -> int:
    """Publisher loop body: hand unpublished rows to `sink(event_type, payload)`, mark them published."""
    pending = session.query(OutboxEvent).filter(OutboxEvent.published_at.is_(None)).order_by(OutboxEvent.created_at)
    count = 0
    for event in pending:
        sink(event.event_type, json.loads(event.payload))
        event.published_at = datetime.now(UTC)
        count += 1
    session.commit()
    return count
