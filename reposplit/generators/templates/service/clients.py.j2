"""Typed downstream clients for {{ service }} - generated by RepoSplit 2.0 (Contract Agent).

Each severed in-memory call became an internal RPC on the owning service. These clients keep the
original call shape (`clients.user_service.find_user(user_id)`) so ported code reads naturally,
while adding what a network boundary needs: timeouts, retries on connection errors, security
context propagation, and a small circuit breaker.

Responses are wrapped in `Ref` (a dict with attribute access) so `user.id` keeps working on data
that used to be an ORM row.
"""

from __future__ import annotations

import os
import time
from typing import Any

import httpx

from app.middleware import current_context


class Ref(dict):
    """Attribute-access view over a JSON object returned by another service."""

    def __getattr__(self, name: str) -> Any:
        try:
            return self[name]
        except KeyError as exc:
            raise AttributeError(name) from exc

    def to_dict(self) -> dict[str, Any]:
        return dict(self)


def _wrap(value: Any) -> Any:
    if isinstance(value, dict):
        return Ref({k: _wrap(v) for k, v in value.items()})
    if isinstance(value, list):
        return [_wrap(v) for v in value]
    return value


class DownstreamError(RuntimeError):
    def __init__(self, service: str, status: int, detail: str) -> None:
        super().__init__(f"{service} -> {status}: {detail}")
        self.service, self.status, self.detail = service, status, detail


class _ServiceClient:
    name = "service"
    failure_threshold = 5
    reset_after_s = 30.0

    def __init__(self, base_url: str, timeout: float = 10.0) -> None:
        self.base_url = base_url.rstrip("/")
        self._http = httpx.Client(timeout=timeout)
        self._failures = 0
        self._opened_at = 0.0

    def _call(self, method: str, path: str, json: dict[str, Any] | None = None) -> Any:
        if self._failures >= self.failure_threshold and time.monotonic() - self._opened_at < self.reset_after_s:
            raise DownstreamError(self.name, 503, "circuit open")
        headers = current_context().outbound_headers()
        last_exc: Exception | None = None
        for attempt in range(3):
            try:
                resp = self._http.request(method, self.base_url + path, json=json, headers=headers)
                break
            except httpx.TransportError as exc:
                last_exc = exc
                time.sleep(0.1 * (attempt + 1))
        else:
            self._failures += 1
            self._opened_at = time.monotonic()
            raise DownstreamError(self.name, 503, f"unreachable: {last_exc}")
        if resp.status_code >= 500:
            self._failures += 1
            self._opened_at = time.monotonic()
            raise DownstreamError(self.name, resp.status_code, resp.text[:200])
        self._failures = 0
        if resp.status_code >= 400:
            raise DownstreamError(self.name, resp.status_code, resp.text[:200])
        if not resp.content:
            return None
        return _wrap(resp.json())


{% for svc in downstream %}
class {{ svc | pascal }}Client(_ServiceClient):
    name = "{{ svc }}"

{% for ep in rpcs[svc] %}
{% if ep.method == "GET" %}
    def {{ ep.operation_id }}(self, id):
        return self._call("GET", f"{{ ep.path.replace('{id}', '{id}') }}")

{% else %}
    def {{ ep.operation_id }}(self{% for p in ep.params %}, {{ p.name }}{% if not p.required %}={{ p.default }}{% endif %}{% endfor %}):
        return self._call("POST", "{{ ep.path }}", {{ '{' }}{% for p in ep.params %}"{{ p.name }}": {{ p.name }}{{ ", " if not loop.last }}{% endfor %}{{ '}' }})

{% endif %}
{% endfor %}

{{ svc }} = {{ svc | pascal }}Client(os.environ.get("{{ svc | upper }}_URL", "http://{{ svc }}:{{ ports[svc] }}"))
{% endfor %}
