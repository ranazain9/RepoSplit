"""Security context propagation for {{ service }} - generated by RepoSplit 2.0 (Contract Agent).

In the monolith "who is logged in" was implicit process state. Across a network boundary it must
travel explicitly. This middleware captures the propagated headers into a contextvar and the
generated clients re-emit them on every downstream call:

{% for h in headers %}
    {{ h }}
{% endfor %}

`traceparent` follows the W3C Trace Context spec so IBM Instana / OpenTelemetry can stitch the
distributed trace across the severed services.

TODO(team): validate the JWT in `Authorization` and derive X-User-Id / X-Tenant-Id from its claims
instead of trusting the inbound headers at the edge.
"""

from __future__ import annotations

import contextvars
import secrets
from dataclasses import dataclass, field

from starlette.middleware.base import BaseHTTPMiddleware
from starlette.requests import Request

PROPAGATED_HEADERS = [{% for h in headers %}"{{ h }}"{{ ", " if not loop.last }}{% endfor %}]


@dataclass
class SecurityContext:
    user_id: str | None = None
    tenant_id: str | None = None
    traceparent: str = ""
    extra: dict[str, str] = field(default_factory=dict)

    def outbound_headers(self) -> dict[str, str]:
        headers = {"traceparent": self.traceparent or new_traceparent()}
        if self.user_id:
            headers["X-User-Id"] = self.user_id
        if self.tenant_id:
            headers["X-Tenant-Id"] = self.tenant_id
        headers.update(self.extra)
        return headers


_current: contextvars.ContextVar[SecurityContext] = contextvars.ContextVar("reposplit_security_context")


def new_traceparent() -> str:
    return f"00-{secrets.token_hex(16)}-{secrets.token_hex(8)}-01"


def current_context() -> SecurityContext:
    try:
        return _current.get()
    except LookupError:
        ctx = SecurityContext(traceparent=new_traceparent())
        _current.set(ctx)
        return ctx


class SecurityContextMiddleware(BaseHTTPMiddleware):
    async def dispatch(self, request: Request, call_next):
        ctx = SecurityContext(
            user_id=request.headers.get("X-User-Id"),
            tenant_id=request.headers.get("X-Tenant-Id"),
            traceparent=request.headers.get("traceparent") or new_traceparent(),
            extra={h: request.headers[h] for h in PROPAGATED_HEADERS if h in request.headers and h not in ("X-User-Id", "X-Tenant-Id", "traceparent")},
        )
        token = _current.set(ctx)
        try:
            response = await call_next(request)
        finally:
            _current.reset(token)
        response.headers["traceparent"] = ctx.traceparent
        return response
