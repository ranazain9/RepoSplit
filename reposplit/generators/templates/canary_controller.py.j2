"""Canary controller generated by RepoSplit 2.0 (Strangler Fig Agent).

Polls Envoy's admin stats, computes the 5xx rate per canary cluster, and rolls a route back to
100% monolith when the rate breaches the threshold. Promotion between stages is deliberate
(a human or CI job calls `promote()`), rollback is automatic.

Usage:  python canary_controller.py --admin http://localhost:9901 --envoy-config envoy.yaml
"""

from __future__ import annotations

import argparse
import re
import time
import urllib.request

import yaml

ROLLBACK_THRESHOLD = {{ plan.rollback_error_rate_threshold }}
STAGES = [{% for s in plan.stages %}{{ s.canary_weight }}{{ ", " if not loop.last }}{% endfor %}]
SERVICES = [{% for svc in plan.routes | map(attribute="service") | unique | sort %}"{{ svc }}"{{ ", " if not loop.last }}{% endfor %}]

_STAT = re.compile(r"^cluster\.(?P<cluster>[\w-]+)\.upstream_rq_(?P<code>2xx|5xx|total): (?P<value>\d+)$")


def read_stats(admin_url: str) -> dict[str, dict[str, int]]:
    with urllib.request.urlopen(f"{admin_url}/stats") as resp:  # noqa: S310 - local admin endpoint
        text = resp.read().decode()
    stats: dict[str, dict[str, int]] = {}
    for line in text.splitlines():
        m = _STAT.match(line.strip())
        if m:
            stats.setdefault(m["cluster"], {})[m["code"]] = int(m["value"])
    return stats


def error_rate(stats: dict[str, dict[str, int]], cluster: str) -> float:
    s = stats.get(cluster, {})
    total = s.get("total", 0)
    return (s.get("5xx", 0) / total) if total else 0.0


def set_weight(config_path: str, service: str, canary_weight: int) -> None:
    with open(config_path, encoding="utf-8") as fh:
        cfg = yaml.safe_load(fh)
    vhosts = cfg["static_resources"]["listeners"][0]["filter_chains"][0]["filters"][0]["typed_config"]["route_config"]["virtual_hosts"]
    for route in vhosts[0]["routes"]:
        clusters = route.get("route", {}).get("weighted_clusters", {}).get("clusters")
        if not clusters or clusters[1]["name"] != service:
            continue
        clusters[0]["weight"] = 100 - canary_weight
        clusters[1]["weight"] = canary_weight
    with open(config_path, "w", encoding="utf-8") as fh:
        yaml.safe_dump(cfg, fh, sort_keys=False)
    print(f"[canary] {service}: canary weight -> {canary_weight}% (reload Envoy or use xDS to apply)")


def promote(config_path: str, service: str, current: int) -> int:
    nxt = next((w for w in STAGES if w > current), current)
    set_weight(config_path, service, nxt)
    return nxt


def watch(admin_url: str, config_path: str, interval: float = 10.0) -> None:
    while True:
        stats = read_stats(admin_url)
        for svc in SERVICES:
            rate = error_rate(stats, svc)
            print(f"[canary] {svc}: 5xx rate {rate:.4%}")
            if rate > ROLLBACK_THRESHOLD:
                print(f"[canary] ROLLBACK {svc}: {rate:.4%} > {ROLLBACK_THRESHOLD:.4%}")
                set_weight(config_path, svc, 0)
        time.sleep(interval)


if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument("--admin", default="http://localhost:9901")
    ap.add_argument("--envoy-config", default="envoy.yaml")
    ap.add_argument("--promote", metavar="SERVICE", help="advance SERVICE to the next canary stage and exit")
    ap.add_argument("--current", type=int, default=STAGES[0])
    args = ap.parse_args()
    if args.promote:
        promote(args.envoy_config, args.promote, args.current)
    else:
        watch(args.admin, args.envoy_config)
