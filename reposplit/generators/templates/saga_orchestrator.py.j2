"""Saga orchestrator generated by RepoSplit 2.0 (DataSplit Engine).

Replaces multi-table ACID transactions that used to span domains with an asynchronous,
compensable workflow. Each forward step calls a downstream service; if a later step fails the
orchestrator runs the recorded compensations in reverse order (backward recovery).

State is persisted through the Outbox pattern (see outbox.py) so a crashed orchestrator can be
resumed. Transport is pluggable: the default is synchronous HTTP through the generated clients;
swap `StepExecutor` for a NATS/Kafka publisher for fully asynchronous choreography.

TODO(team): wire `StepExecutor` to the real generated clients in services/<service>/app/clients.py.
"""

from __future__ import annotations

import enum
import logging
import uuid
from collections.abc import Callable
from dataclasses import dataclass, field
from typing import Any

log = logging.getLogger("reposplit.saga")


class SagaState(enum.StrEnum):
    PENDING = "PENDING"
    RUNNING = "RUNNING"
    COMPLETED = "COMPLETED"
    COMPENSATING = "COMPENSATING"
    COMPENSATED = "COMPENSATED"
    FAILED = "FAILED"


class StepFailed(Exception):
    pass


@dataclass
class SagaStep:
    name: str
    service: str
    action: str
    compensation: str | None = None


@dataclass
class SagaDefinition:
    name: str
    trigger: str
    orchestrator_service: str
    steps: list[SagaStep]


@dataclass
class SagaInstance:
    definition: SagaDefinition
    payload: dict[str, Any]
    saga_id: str = field(default_factory=lambda: uuid.uuid4().hex)
    state: SagaState = SagaState.PENDING
    completed_steps: list[str] = field(default_factory=list)
    step_results: dict[str, Any] = field(default_factory=dict)
    error: str | None = None


StepExecutor = Callable[[SagaStep, dict[str, Any], dict[str, Any]], Any]


class SagaOrchestrator:
    """Generic forward-then-compensate executor."""

    def __init__(self, execute: StepExecutor, compensate: StepExecutor, outbox: Any | None = None) -> None:
        self._execute = execute
        self._compensate = compensate
        self._outbox = outbox

    def _emit(self, instance: SagaInstance, event: str, **data: Any) -> None:
        log.info("saga %s [%s] %s %s", instance.definition.name, instance.saga_id, event, data)
        if self._outbox is not None:
            self._outbox.publish(f"saga.{instance.definition.name}.{event}", {"saga_id": instance.saga_id, **data})

    def run(self, definition: SagaDefinition, payload: dict[str, Any]) -> SagaInstance:
        instance = SagaInstance(definition=definition, payload=payload)
        instance.state = SagaState.RUNNING
        self._emit(instance, "started")
        for step in definition.steps:
            try:
                result = self._execute(step, instance.payload, instance.step_results)
                instance.step_results[step.name] = result
                instance.completed_steps.append(step.name)
                self._emit(instance, "step_completed", step=step.name)
            except Exception as exc:  # noqa: BLE001 - any downstream failure triggers compensation
                instance.error = f"{step.name}: {exc}"
                self._emit(instance, "step_failed", step=step.name, error=str(exc))
                self._rollback(instance)
                return instance
        instance.state = SagaState.COMPLETED
        self._emit(instance, "completed")
        return instance

    def _rollback(self, instance: SagaInstance) -> None:
        instance.state = SagaState.COMPENSATING
        steps = {s.name: s for s in instance.definition.steps}
        for name in reversed(instance.completed_steps):
            step = steps[name]
            if not step.compensation:
                continue
            try:
                self._compensate(step, instance.payload, instance.step_results)
                self._emit(instance, "compensated", step=step.name)
            except Exception as exc:  # noqa: BLE001
                instance.state = SagaState.FAILED
                instance.error = f"{instance.error}; compensation {step.compensation} failed: {exc}"
                self._emit(instance, "compensation_failed", step=step.name, error=str(exc))
                return
        instance.state = SagaState.COMPENSATED


