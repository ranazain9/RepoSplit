def default_executor(clients: Any) -> tuple[StepExecutor, StepExecutor]:
    """Bind saga steps to the generated service clients by convention: clients.<service>.<action>(**payload)."""

    def execute(step: SagaStep, payload: dict[str, Any], results: dict[str, Any]) -> Any:
        client = getattr(clients, step.service)
        fn = getattr(client, step.action)
        return fn(**{k: v for k, v in payload.items() if k in fn.__code__.co_varnames})

    def compensate(step: SagaStep, payload: dict[str, Any], results: dict[str, Any]) -> Any:
        client = getattr(clients, step.service)
        fn = getattr(client, step.compensation)
        merged = {**payload, **(results.get(step.name) or {})} if isinstance(results.get(step.name), dict) else payload
        return fn(**{k: v for k, v in merged.items() if k in fn.__code__.co_varnames})

    return execute, compensate
