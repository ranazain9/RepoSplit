# ==============================================================================
# RepoSplit 2.0 Environment Configuration (Example)
# ==============================================================================

# ---- LLM Provider Selection --------------------------------------------------
# Options:
#   auto      -> groq if GROQ_API_KEY is set, otherwise mock (offline, deterministic)
#   groq      -> Groq via LangChain (fastest inference, ultra-low latency)
#   mock      -> zero network calls, 100% deterministic (CI / offline safe)
#   anthropic -> Claude via Anthropic SDK
#   watsonx   -> IBM watsonx.ai (Granite)
REPOSPLIT_PROVIDER=auto

# ---- Groq Configuration (LangChain) ------------------------------------------
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=
# Recommended models: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Optional Providers ------------------------------------------------------
# Anthropic
ANTHROPIC_API_KEY=
# IBM watsonx.ai
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-8b-instruct

# ---- Engine Behaviour --------------------------------------------------------
# If true, an LLM failure aborts the run instead of falling back to deterministic default.
REPOSPLIT_STRICT_LLM=false

# Ed25519 PEM used by Governance agent. Leave empty to generate an ephemeral key per run.
REPOSPLIT_SIGNING_KEY=
